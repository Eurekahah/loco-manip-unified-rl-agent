#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Root" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:rigidBodyEnabled = true
    float physics:mass = 0.18

    def Xform "Visual" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Environments/Hospital/Props/SM_BottleA.usd@
    )
    {
        double3 xformOp:translate = (0, 0, -0.12475)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "SM_BottleA"
        {
            token physics:approximation = "convexHull"
        }
    }
}
